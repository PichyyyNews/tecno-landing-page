:80 {
    log {
        output stdout
        format console
    }

    # High-ratio compression for text, scripts, and scalable vector graphics
    encode zstd gzip

    # Aggressive browser caching for static WebP images, fonts, and assets (1 year immutable)
    @staticAssets {
        path /department/* /maps/* /amcharts/* /logo.png *.webp *.jpg *.jpeg *.png *.svg *.ico *.woff2
    }
    header @staticAssets {
        Cache-Control "public, max-age=31536000, immutable"
        X-Content-Type-Options "nosniff"
    }

    # Forward API requests to Go backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /health {
        reverse_proxy backend:8080
    }

    # Forward all other requests to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
